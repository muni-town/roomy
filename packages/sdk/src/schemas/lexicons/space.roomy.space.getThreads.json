{
  "lexicon": 1,
  "id": "space.roomy.space.getThreads",
  "defs": {
    "latestMembers": {
      "type": "object",
      "required": [
        "did"
      ],
      "nullable": [
        "avatar",
        "name"
      ],
      "properties": {
        "did": {
          "type": "string"
        },
        "avatar": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "author": {
      "type": "object",
      "required": [
        "did"
      ],
      "nullable": [
        "avatar",
        "name"
      ],
      "properties": {
        "did": {
          "type": "string"
        },
        "avatar": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "latestMessage": {
      "type": "object",
      "required": [
        "author",
        "content",
        "id"
      ],
      "properties": {
        "author": {
          "type": "ref",
          "ref": "#author"
        },
        "content": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "timestamp": {
          "type": "string"
        }
      }
    },
    "activity": {
      "type": "object",
      "required": [
        "latestMembers"
      ],
      "properties": {
        "latestMembers": {
          "type": "array",
          "items": {
            "type": "ref",
            "ref": "#latestMembers"
          }
        },
        "latestMessage": {
          "type": "ref",
          "ref": "#latestMessage"
        },
        "latestTimestamp": {
          "type": "string"
        }
      }
    },
    "rooms": {
      "type": "object",
      "required": [
        "activity",
        "id",
        "kind"
      ],
      "properties": {
        "activity": {
          "type": "ref",
          "ref": "#activity"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "knownValues": [
            "channel",
            "thread"
          ]
        },
        "channel": {
          "type": "string"
        },
        "channelName": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "unread": {
          "type": "boolean"
        },
        "unreadCount": {
          "type": "integer"
        }
      }
    },
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": [
          "spaceId"
        ],
        "properties": {
          "spaceId": {
            "type": "string"
          },
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "string"
          },
          "search": {
            "type": "string"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "rooms"
          ],
          "properties": {
            "rooms": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#rooms"
              }
            },
            "cursor": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
