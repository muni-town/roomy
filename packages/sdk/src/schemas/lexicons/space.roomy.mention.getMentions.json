{
  "lexicon": 1,
  "id": "space.roomy.mention.getMentions",
  "defs": {
    "attachmentFile": {
      "type": "object",
      "required": [
        "$type",
        "type",
        "url"
      ],
      "properties": {
        "$type": {
          "type": "string",
          "knownValues": [
            "space.roomy.attachment.file.v0"
          ]
        },
        "type": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "size": {
          "type": "integer"
        }
      }
    },
    "attachmentForward": {
      "type": "object",
      "required": [
        "$type",
        "messageId",
        "name",
        "roomId"
      ],
      "properties": {
        "$type": {
          "type": "string",
          "knownValues": [
            "space.roomy.attachment.forward.v0"
          ]
        },
        "messageId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "roomId": {
          "type": "string"
        },
        "message": {
          "type": "ref",
          "ref": "#message"
        }
      }
    },
    "attachmentImage": {
      "type": "object",
      "required": [
        "$type",
        "type",
        "url"
      ],
      "properties": {
        "$type": {
          "type": "string",
          "knownValues": [
            "space.roomy.attachment.image.v0"
          ]
        },
        "type": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "alt": {
          "type": "string"
        },
        "blurhash": {
          "type": "string"
        },
        "height": {
          "type": "integer"
        },
        "size": {
          "type": "integer"
        },
        "width": {
          "type": "integer"
        }
      }
    },
    "au": {
      "type": "object",
      "properties": {
        "n": {
          "type": "string"
        },
        "u": {
          "type": "string"
        }
      }
    },
    "footer": {
      "type": "object",
      "properties": {
        "t": {
          "type": "string"
        }
      }
    },
    "imgs": {
      "type": "object",
      "required": [
        "u"
      ],
      "properties": {
        "u": {
          "type": "string"
        },
        "d": {
          "type": "string"
        },
        "h": {
          "type": "integer"
        },
        "m": {
          "type": "string"
        },
        "w": {
          "type": "integer"
        }
      }
    },
    "embed": {
      "type": "object",
      "properties": {
        "au": {
          "type": "ref",
          "ref": "#au"
        },
        "d": {
          "type": "string"
        },
        "footer": {
          "type": "ref",
          "ref": "#footer"
        },
        "imgs": {
          "type": "array",
          "items": {
            "type": "ref",
            "ref": "#imgs"
          }
        },
        "p": {
          "type": "ref",
          "ref": "#au"
        },
        "t": {
          "type": "string"
        },
        "thumb": {
          "type": "ref",
          "ref": "#imgs"
        },
        "vid": {
          "type": "ref",
          "ref": "#imgs"
        }
      }
    },
    "attachmentLink": {
      "type": "object",
      "required": [
        "$type",
        "url"
      ],
      "properties": {
        "$type": {
          "type": "string",
          "knownValues": [
            "space.roomy.attachment.link.v0"
          ]
        },
        "url": {
          "type": "string"
        },
        "embed": {
          "type": "ref",
          "ref": "#embed"
        }
      }
    },
    "attachmentReply": {
      "type": "object",
      "required": [
        "$type",
        "messageId"
      ],
      "properties": {
        "$type": {
          "type": "string",
          "knownValues": [
            "space.roomy.attachment.reply.v0"
          ]
        },
        "messageId": {
          "type": "string"
        }
      }
    },
    "attachmentTile": {
      "type": "object",
      "required": [
        "$type",
        "url"
      ],
      "properties": {
        "$type": {
          "type": "string",
          "knownValues": [
            "space.roomy.attachment.tile.v0"
          ]
        },
        "url": {
          "type": "string"
        },
        "data": {
          "type": "unknown"
        }
      }
    },
    "attachmentVideo": {
      "type": "object",
      "required": [
        "$type",
        "type",
        "url"
      ],
      "properties": {
        "$type": {
          "type": "string",
          "knownValues": [
            "space.roomy.attachment.video.v0"
          ]
        },
        "type": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "alt": {
          "type": "string"
        },
        "blurhash": {
          "type": "string"
        },
        "height": {
          "type": "integer"
        },
        "length": {
          "type": "integer"
        },
        "size": {
          "type": "integer"
        },
        "width": {
          "type": "integer"
        }
      }
    },
    "linkEmbeds": {
      "type": "object",
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string"
        },
        "embed": {
          "type": "ref",
          "ref": "#embed"
        }
      }
    },
    "media": {
      "type": "object",
      "required": [
        "type",
        "url"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "alt": {
          "type": "string"
        },
        "blurhash": {
          "type": "string"
        },
        "height": {
          "type": "integer"
        },
        "length": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "size": {
          "type": "integer"
        },
        "width": {
          "type": "integer"
        }
      }
    },
    "reactions": {
      "type": "object",
      "required": [
        "count",
        "emoji"
      ],
      "properties": {
        "count": {
          "type": "integer"
        },
        "emoji": {
          "type": "string"
        },
        "myReactionId": {
          "type": "string"
        }
      }
    },
    "forwardedFrom": {
      "type": "object",
      "required": [
        "messageId",
        "name",
        "roomId"
      ],
      "properties": {
        "messageId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "roomId": {
          "type": "string"
        },
        "message": {
          "type": "ref",
          "ref": "#message"
        }
      }
    },
    "message": {
      "type": "object",
      "required": [
        "attachments",
        "authorDid",
        "authorName",
        "content",
        "id",
        "linkEmbeds",
        "media",
        "reactions",
        "timestamp"
      ],
      "properties": {
        "attachments": {
          "type": "array",
          "items": {
            "type": "union",
            "closed": true,
            "refs": [
              "#attachmentFile",
              "#attachmentForward",
              "#attachmentImage",
              "#attachmentLink",
              "#attachmentReply",
              "#attachmentTile",
              "#attachmentVideo"
            ]
          }
        },
        "authorDid": {
          "type": "string"
        },
        "authorName": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "linkEmbeds": {
          "type": "array",
          "items": {
            "type": "ref",
            "ref": "#linkEmbeds"
          }
        },
        "media": {
          "type": "array",
          "items": {
            "type": "ref",
            "ref": "#media"
          }
        },
        "reactions": {
          "type": "array",
          "items": {
            "type": "ref",
            "ref": "#reactions"
          }
        },
        "timestamp": {
          "type": "string"
        },
        "authorAvatar": {
          "type": "string"
        },
        "authorHandle": {
          "type": "string"
        },
        "blocked": {
          "type": "boolean"
        },
        "forwardedFrom": {
          "type": "ref",
          "ref": "#forwardedFrom"
        },
        "lastEdit": {
          "type": "string"
        },
        "mimeType": {
          "type": "string"
        },
        "replyTo": {
          "type": "string"
        },
        "sort_idx": {
          "type": "string"
        },
        "system": {
          "type": "boolean"
        }
      }
    },
    "mentions": {
      "type": "object",
      "required": [
        "kind",
        "message",
        "roomId",
        "spaceId"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "knownValues": [
            "mention",
            "reply"
          ]
        },
        "message": {
          "type": "ref",
          "ref": "#message"
        },
        "roomId": {
          "type": "string"
        },
        "spaceId": {
          "type": "string"
        }
      }
    },
    "output": {
      "type": "object",
      "required": [
        "mentions"
      ],
      "properties": {
        "mentions": {
          "type": "array",
          "items": {
            "type": "ref",
            "ref": "#mentions"
          }
        },
        "cursor": {
          "type": "string"
        }
      }
    },
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": [
          "did"
        ],
        "properties": {
          "did": {
            "type": "string"
          },
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "string"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "ref",
          "ref": "#output"
        }
      }
    }
  }
}
