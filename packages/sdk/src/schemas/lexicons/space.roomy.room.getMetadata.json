{
  "lexicon": 1,
  "id": "space.roomy.room.getMetadata",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": [
          "roomId"
        ],
        "properties": {
          "roomId": {
            "type": "string"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "canRead",
            "canWrite",
            "defaultAccess",
            "kind",
            "spaceId",
            "unreadCount",
            "unreadThreadCount"
          ],
          "properties": {
            "canRead": {
              "type": "boolean"
            },
            "canWrite": {
              "type": "boolean"
            },
            "defaultAccess": {
              "type": "string",
              "knownValues": [
                "none",
                "read",
                "readwrite"
              ]
            },
            "kind": {
              "type": "string"
            },
            "spaceId": {
              "type": "string"
            },
            "unreadCount": {
              "type": "integer"
            },
            "unreadThreadCount": {
              "type": "integer"
            },
            "lastRead": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "parentChannelId": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
