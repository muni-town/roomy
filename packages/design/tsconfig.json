{
  "extends": ["@repo/tsconfig/base.json"],
  "compilerOptions": {
    "moduleResolution": "bundler",
    "module": "es2022",
    "target": "es2022",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitAny": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    // The only host that type-checks this package is Storybook, which serves
    // `$app/*` from .storybook/app-stubs (see .storybook/main.ts). SvelteKit's
    // virtual modules are otherwise unresolvable: this package has no runtime
    // of its own.
    "paths": {
      "$app/*": ["./.storybook/app-stubs/*"]
    }
  },
  "include": ["src/**/*"]
}
