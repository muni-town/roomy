{
  "lexicon": 1,
  "id": "space.roomy.mention.getMentions",
  "defs": {
    "mention": {
      "type": "object",
      "required": ["message", "spaceId", "roomId", "kind"],
      "properties": {
        "message": { "type": "unknown" },
        "spaceId": { "type": "string" },
        "roomId": { "type": "string" },
        "kind": { "type": "string", "knownValues": ["mention", "reply"] }
      }
    },
    "main": {
      "type": "query",
      "description": "Get recent messages that mention a user, across all spaces the caller can read. Backfill for the mentions:<did> sync topic.",
      "parameters": {
        "type": "params",
        "required": ["did"],
        "properties": {
          "did": { "type": "string" },
          "limit": { "type": "integer" },
          "cursor": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["mentions"],
          "properties": {
            "mentions": { "type": "array", "items": { "type": "ref", "ref": "#mention" } },
            "cursor": { "type": "string" }
          }
        }
      }
    }
  }
}
