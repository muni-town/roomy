# ── Appserver ────────────────────────────────────────────────────────────
# Copy this file to .env and fill in values.
# Defaults shown are for local development.

# HTTP port the Bun server listens on
PORT=8080

# DID of this appserver — must match the did.json served at /.well-known/did.json.
# Used for JWT audience validation and as the DID document subject.
APPSERVER_DID=did:web:api.roomy.space

# Public origin of this appserver — the URL clients use to reach it.
# Served as the serviceEndpoint in the DID document.
# On Railway, use RAILWAY_PUBLIC_DOMAIN for external clients or
# RAILWAY_PRIVATE_DOMAIN for inter-service traffic (avoids egress fees).
APPSERVER_ORIGIN=https://api.roomy.space

# Comma-separated DIDs allowed to call admin XRPC endpoints.
# Fails closed: if unset, all admin requests are rejected.
# Set at least one DID in development.
APPSERVER_ADMIN_DIDS=



# ── Databases (SQLite) ───────────────────────────────────────────────────

# Single data directory for all SQLite DBs (event log, read-state, global)
# and the per-space DBs (under DATA_DIR/spaces). Defaults to `data`.
DATA_DIR=data

# When to backfill Leaf streams into the materialisation DB:
#   eager (default) — discover + materialise every network stream at boot
#   lazy            — materialise each space on first request instead
#   disabled        — skip all Leaf contact (tests / hermetic E2E)
# Lazy trades first-request completeness for fast boot; invalidation signals
# fill in the rest once backfill completes. Disabled skips backfill entirely
# so the server never touches Leaf — for integration tests that exercise the
# HTTP/WS interface without an event-stream backend.
APPSERVER_BACKFILL_MODE=eager

# Max spaces materialised concurrently during eager startup backfill (default 4).
# Overlaps per-space Leaf subscription + profile fetches; SQLite writes still
# serialize on the single WAL writer. Lower if Leaf or the appview struggles.
# (Lowered from 8→4 after 8 workers wedged Leaf at ~885 streams in prod.)
APPSERVER_BACKFILL_CONCURRENCY=4

# ── Backfill circuit breaker ────────────────────────────────────────────
# When a backfill worker hits this many consecutive failures, it pauses with
# exponential backoff (below) before pulling the NEXT stream. Stops a wedged
# Leaf from being hammered by a 30s-timeout-per-stream churn.
APPSERVER_BACKFILL_FAILURE_THRESHOLD=3
# Base pause (ms) for the first breaker trip; doubles each trip up to the cap.
APPSERVER_BACKFILL_BACKOFF_MS=5000
# Maximum pause (ms) between streams during a sustained outage.
APPSERVER_BACKFILL_BACKOFF_MAX_MS=60000
# Emit a `[startup] progress …` line every N completed spaces (plus the final
# one). Default 50 avoids per-DID log flooding at scale; set 1 for per-DID detail.
APPSERVER_BACKFILL_PROGRESS_EVERY=50
# Timeout (ms) for mat.close() (drain + Leaf unsubscribe) during startup
# backfill. close() isn't SDK-bounded, so a dead Leaf can't strand a worker.
# NOTE: a timed-out close() is NOT cancelled — its Leaf subscription lingers
# in the background and may accumulate transiently under outage + timeout.
APPSERVER_BACKFILL_CLOSE_TIMEOUT_MS=15000
# Connect deadline (ms) for RoomyServiceClient.connectSpace. Bounds streamInfo +
# mod CID/upload/update so a dead Leaf socket can't hang callers (incl. all
# backfill workers + XRPC handlers sharing the cached client).
APPSERVER_CONNECT_TIMEOUT_MS=30000

# ── Logging ─────────────────────────────────────────────────────────────
# Threshold (inclusive): debug < info < warn < error. Default info.
# Set debug to see embed-sweeper internals.
LOG_LEVEL=info

# Loki push API endpoint (Grafana Alloy collector, deploy/alloy/). When set,
# every log record is batched and POSTed here in Loki JSON format in addition
# to stdout. Leave unset in local dev (stdout only).
# ALLOY_URL=http://alloy:3100/loki/api/v1/push

# Path to the debug event store (optional, for forensics).
# When set, every raw event and materialization result is logged to this
# separate DB. Query with sqlite3 CLI. Leave unset in production.
APPSERVER_DEBUG_DB_PATH=data/debug.sqlite

# ── Personal stream resolution ───────────────────────────────────────────

# ATProto collection NSID for personal-stream records on user PDS repos
APPSERVER_PERSONAL_STREAM_NSID=space.roomy.space.personal.next

# Schema version rkey for personal-stream records
APPSERVER_PERSONAL_STREAM_SCHEMA_VERSION=4

# ── Identity resolution ──────────────────────────────────────────────────

# PLC directory URL for DID resolution
PLC_DIRECTORY_URL=https://plc.directory

# ── Arbiter (space provisioning) ──────────────────────────────────────────
# When both are set, new spaces are provisioned as real ATProto accounts via
# the arbiter server (leaf-0.4) instead of self-generated did:plc DIDs. The
# arbiter creates the account on the Roomy PDS, installs the default policy
# (owner = this appserver), and writes the space.roomy.service/self record.
# Leave unset to keep the legacy self-provisioned path.
ARBITER_URL=
# The arbiter server's own DID (the `aud` of serviceAuth tokens). For a
# did:web with a non-default port, percent-encode the port (e.g.
# did:web:localhost%3A8203).
ARBITER_DID=

# ── CORS ─────────────────────────────────────────────────────────────────

# Allowed origin for CORS headers. Set to your app URL in production.
# Use "*" for development (allows all origins).
CORS_ORIGIN=*

# ── Rate limiting ────────────────────────────────────────────────────────
# Rate limiting uses `rate-limiter-flexible` with an in-memory counter.
# Keys are derived from the direct connection IP by default.
# Set RATE_LIMIT_TRUST_PROXY=true to use X-Forwarded-For instead.
# Set RATE_LIMIT_DISABLED=true to disable all rate limiting (e.g. in tests).

RATE_LIMIT_POINTS=100
RATE_LIMIT_DURATION=60
RATE_LIMIT_BLOCK_DURATION=120
RATE_LIMIT_TRUST_PROXY=false
RATE_LIMIT_DISABLED=false

# —— EMBED SERVICE ————————————————————————————————————————————————————
# Embed (link-card) metadata service. POST a URL, returns OpenGraph/oEmbed.
EMBED_SERVICE_URL=https://embed.internal.weird.one
# Hard timeout (ms) for a single embed-service request. Without it a hung
# service leaves links pending and amplifies re-fetches.
EMBED_FETCH_TIMEOUT_MS=10000
# Max concurrent outbound embed-service fetches per sweep batch. Bounded so a
# large pending batch can't flood the service while still draining quickly.
EMBED_SWEEPER_CONCURRENCY=8
# Cap (ms) for transient-failure retry backoff (schedule: 1m→5m→30m→2h→cap).
EMBED_RETRY_CAP_MS=21600000

# —— QDRANT SEARCH ————————————————————————————————————————————————————
# Qdrant message-search service (Phase 2 of search-endpoints.md). When
# QDRANT_URL is unset, message search is unavailable but the appserver runs
# fine (indexer queues nothing; space.roomy.search.messages returns 503).
QDRANT_URL=https://search-staging.roomy.space
# API key for authenticated Qdrant deployments.
QDRANT_API_KEY=

# ── Polar billing (Roomy Pro) ────────────────────────────────────────────
# Roomy Pro subscriptions are billed via polar.sh. When POLAR_ACCESS_TOKEN
# is unset (or ROOMY_PRO_PRODUCT_ID missing), the bridge-token endpoints and
# pro.checkout reject with 503 — billing is unavailable.
# Token scope: `customers:read` (status reads) + `checkouts:write` (minting
# checkout sessions bound to the user's DID).
POLAR_ACCESS_TOKEN=
# API base URL. Production https://api.polar.sh/v1; sandbox
# https://sandbox-api.polar.sh/v1 (isolated data + tokens).
POLAR_ENDPOINT=https://api.polar.sh/v1
# Polar product ID of the Roomy Pro subscription (grants 1000 capacity).
ROOMY_PRO_PRODUCT_ID=
# Public origin of the Roomy app. Polar redirects customers here after
# checkout (`?checkout={CHECKOUT_ID}`). Defaults to https://roomy.space.
ROOMY_APP_ORIGIN=https://roomy.space

# ── Web Push (VAPID) ─────────────────────────────────────────────────────
# Generate once per environment with `bun run scripts/generate-vapid.ts`.
# The PUBLIC key is handed to browsers so they can create a PushSubscription;
# the PRIVATE key stays on the appserver and signs the VAPID JWT for delivery.
# Rotating keys invalidates existing subscriptions (browsers must re-subscribe
# with the new public key). When unset, the appserver still serves the push
# lexicons but skips delivery (useful for dev/test without push configured).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: or URL contact for the push service. E.g. mailto:you@example.com
VAPID_SUBJECT=
# Max concurrent outbound push-service calls the dispatcher makes (default 8).
PUSH_CONCURRENCY=8


# ── Test mode ─────────────────────────────────────────────────────────────
# When true, the appserver uses a test auth verifier that reads the caller's
# DID from the `X-Test-Did` request header instead of verifying a real ATProto
# JWT via PLC resolution. This lets E2E/integration tests impersonate any user
# without a live PDS or network. NEVER enable in production — it accepts any
# DID without proof of identity.
APPSERVER_TEST_MODE=false