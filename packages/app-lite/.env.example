# Discord bridge configuration
PUBLIC_DISCORD_BRIDGE=http://localhost:3301
PUBLIC_BRIDGE_DID=did:plc:vjztjtisourrydgksg44u7fe

# PDS configuration for account creation / login
PUBLIC_PDS="https://roomy.chat"
PUBLIC_PDS_HANDLE_SUFFIX=".roomy.chat"
PUBLIC_PDS_INVITE_CODE="roomy-chat-zabzv-rh4xd" 

# Appserver DID (Staging)
# VITE_APPSERVER_DID=did:web:api-staging.roomy.space
# Appserver DID (Production)
VITE_APPSERVER_DID=did:web:api.roomy.space

# HappyView instance that custodies the user's ATProto OAuth session. The
# browser holds only a HappyView DPoP session; PDS tokens live server-side at
# HappyView (encrypted). VITE_OAUTH_CLIENT_ID points at the served OAuth
# client metadata document (see scripts/build-prod.sh); unset → dev loopback
# client id (or the Tauri native metadata in the desktop webview).
# VITE_HAPPYVIEW_ENDPOINT=https://happyview.roomy.chat
# VITE_HAPPYVIEW_CLIENT_KEY=hvc_your_client_key
# VITE_OAUTH_CLIENT_ID=https://roomy.space/oauth-client-metadata.json

# Handle→DID resolver for sign-in. Defaults to Roomy's resolver
# (resolver.roomy.chat/xrpc/com.atproto.identity.resolveHandle — the standard
# atproto NSID; distinct from the Leaf handle endpoint the space-handle
# settings page verifies), replacing DNS/DoH resolution — no login traffic
# goes to dns.google.
# VITE_HANDLE_RESOLVER_URL=https://resolver.roomy.chat/xrpc/com.atproto.identity.resolveHandle

# Public web deployment — the origin shareable links (invite links) are rooted
# at. Never the document origin: the desktop app is a Tauri webview whose
# document origin is `tauri://localhost`, which a link recipient cannot open.
# VITE_PUBLIC_WEB_ORIGIN sets it (default https://roomy.space). Set
# PUBLIC_WEB_ORIGIN to the origin THIS build is served from, and only for a
# web deployment: when it matches the document origin the deployment links to
# itself (self-hosted/staging), otherwise the build links to the public app.
# VITE_PUBLIC_WEB_ORIGIN=https://roomy.space
# PUBLIC_WEB_ORIGIN=https://roomy.space

# Test-mode: app-password credentials for headless E2E testing. When both are
# set, the app auto-logs in via app password (bypassing OAuth) so browser-based
# tests can exercise the full XRPC + sync stack without a public redirect URI.
# The login targets PUBLIC_PDS (set above), because an app password only
# authenticates against the PDS that issued it.
# Create an app password in your PDS account settings.
# PUBLIC_TEST_IDENTIFIER=did:plc:your-test-did
# PUBLIC_TEST_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Grafana Faro endpoint for browser telemetry (frontend log collection).
# Points at an Alloy `faro.receiver` — dev compose runs one on
# http://127.0.0.1:12345 with key "bad_api_key"; production uses the
# deploy/alloy collector. The Faro agent POSTs to <url>/collect, so include
# the path. When unset (dev/build default) the Faro SDK is never loaded.
# PUBLIC_FARO_URL=http://127.0.0.1:12345/collect
# PUBLIC_FARO_API_KEY=bad_api_key
