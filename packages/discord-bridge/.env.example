DISCORD_TOKEN=
ATPROTO_BRIDGE_DID=
ATPROTO_BRIDGE_APP_PASSWORD=
APPSERVER_URL=http://127.0.0.1:8080
APPSERVER_DID=
STREAM_NSID=space.roomy.space.personal.dev
STREAM_HANDLE_NSID=space.roomy.space.handle.dev
BRIDGE_DATA_DIR=./data
PORT=3301
LOG_LEVEL=info

# Ops kill switch for Roomy Pro capacity enforcement. true/1 disables
# per-guild capacity checks globally: every bridged space passes regardless
# of member count vs capacity. Emergency manual re-enable — off by default.
# BRIDGE_CAPACITY_KILL_SWITCH=false

# Loki push API endpoint (Grafana Alloy collector, deploy/alloy/). When set,
# every log record is batched and POSTed here in Loki JSON format in addition
# to stdout. Leave unset in local dev (stdout only).
# ALLOY_URL=http://alloy:3100/loki/api/v1/push
