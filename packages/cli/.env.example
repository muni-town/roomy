# ── Roomy CLI ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in values.
# The CLI reads these from the environment (not a .env file directly).

# ATProto credentials (required)
# Your Bluesky handle or DID
ATPROTO_IDENTIFIER=

# App password (generate at https://bsky.app/settings/app-passwords)
ATPROTO_APP_PASSWORD=

# Appserver connection (defaults shown are for local development)
# URL of the Roomy appserver
APPSERVER_URL=http://localhost:8080

# DID of the appserver
APPSERVER_DID=did:web:api.roomy.space

# Message cache root for `roomy export` (one directory per space, one file per
# room). Defaults to ~/.roomy/cache.
ROOMY_CACHE_DIR=
