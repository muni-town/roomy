[Unit]
Description=Roomy -> omp agent bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=exedev
ExecStart=/home/exedev/roomy/packages/cli/run-omp-bridge.sh
Restart=always
RestartSec=5
# The runner script sources OLLAMA_CLOUD_API_KEY from ~/.omp/agent/ollama-cloud.env
Environment=PI_CODING_AGENT_DIR=/home/exedev/.omp/agent

[Install]
WantedBy=multi-user.target
