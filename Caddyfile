
:80 {
	root * /usr/share/caddy

	# Invite-link unfurls. A join link (`/join?space=…&invite=…`, or
	# `/join/<ref>`) is the same SPA shell for every space, and a link-preview
	# crawler never runs the bundle that would name the space — so it would
	# unfurl as the site-wide card. A crawler's request is instead answered by
	# the appserver (`packages/appserver/src/og/`): a page whose og tags name the
	# space and whose og:image is that space's invite card. People still get
	# the SPA below.
	#
	# Matched by User-Agent: the link-preview fetchers of the chat apps and
	# social sites a join link is pasted into (iMessage sends
	# facebookexternalhit/Twitterbot; Signal sends WhatsApp). Search crawlers
	# are deliberately absent. A browser that matches by accident gets a page
	# with an "Open in Roomy" link, not a broken app.
	#
	# APPSERVER_ORIGIN is read when Caddy loads this file; it defaults to the
	# production appserver. Host is rewritten to the upstream's: the appserver
	# sits behind its own host-routed edge.
	@join path /join /join/*
	header @join +Vary User-Agent

	@unfurl {
		path /join /join/*
		header_regexp User-Agent "(?i)(facebookexternalhit|facebot|twitterbot|discordbot|slackbot|slack-imgproxy|linkedinbot|whatsapp|telegrambot|skypeuripreview|microsoftpreview|redditbot|mastodon|bluesky|cardyb|embedly|iframely|pinterest|vkshare|tumblr|snap url preview|zulipurlpreview|synapse|mattermost|rocket\.chat|applebot)"
	}
	handle @unfurl {
		rewrite * /og{uri}
		reverse_proxy {$APPSERVER_ORIGIN:https://api.roomy.space} {
			header_up Host {upstream_hostport}
		}
	}

	# Content-hashed build output. The filename changes whenever the content
	# does, so a hit is safe to cache forever — and a miss MUST 404, never fall
	# back to the SPA shell. Serving index.html (200 text/html) under a .js/.css
	# URL is a module-load failure in every browser ("Failed to fetch
	# dynamically imported module", "doesn't provide an export named"), and
	# because that fallback is cacheable a CDN stores the bad body and keeps
	# serving it after the deploy that caused it. Nothing under /_app/ is a
	# client route, so serving it straight from disk costs nothing.
	handle /_app/immutable/* {
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# The Apple App Site Association, which decides whether a shared
	# `https://roomy.space/…` link opens the iOS app or the web app. It is
	# extensionless, so Caddy's extension-based MIME lookup (see
	# `file_server`) resolves nothing and the response would carry no
	# Content-Type: Apple requires `application/json` and reports the file as
	# bad content without it. Served straight from disk, and a miss is a 404
	# rather than the app shell — for a host the app does not claim, the build
	# writes no file at all and 404 is the honest answer.
	handle /.well-known/apple-app-site-association {
		header Content-Type "application/json"
		file_server
	}

	# The rest of /_app/ (env.js, version.json). version.json is how the
	# client detects a new deploy, so it must always revalidate.
	handle /_app/* {
		header Cache-Control "no-cache"
		file_server
	}

	# Every other path is a client-side route: serve the app shell, which must
	# revalidate too. A shell cached past a deploy is exactly the stale document
	# that then asks for assets which no longer exist.
	handle {
		try_files {path} /index.html
		header Cache-Control "no-cache"
		file_server
	}
}
