# ── Appserver Dockerfile ──────────────────────────────────────────────────
# Multi-stage build for the Roomy appserver (Bun + SQLite).
#
# The appserver depends on workspace packages (SDK, tsconfig) and uses
# bun:sqlite + Bun.serve at runtime, so it must run on Bun.
#
# Build stage uses Node.js because some transitive workspace dependencies
# fail during pnpm install under Bun (node:sqlite not yet available).
#
# The SQL schema files are loaded at runtime via readFileSync relative to
# import.meta.url, so we run from source rather than a bun build bundle.

# ── Stage 1: Install dependencies & build workspace packages ──────────────
FROM node:22 AS build

ARG RAILWAY_GIT_COMMIT_SHA
ENV BUILD_ID=${RAILWAY_GIT_COMMIT_SHA%"${RAILWAY_GIT_COMMIT_SHA#??*??????}"}

WORKDIR /project

RUN npm i -g pnpm

# Copy workspace manifests and patches for install
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json turbo.json ./
COPY patches/ patches/
COPY packages/tsconfig/package.json packages/tsconfig/package.json
COPY packages/sdk/package.json packages/sdk/package.json
COPY packages/appserver/package.json packages/appserver/package.json

# Install dependencies (ignore scripts — husky prepare not needed in Docker)
RUN pnpm install --frozen-lockfile --ignore-scripts

# Copy source for packages the appserver depends on
COPY packages/tsconfig/ packages/tsconfig/
COPY packages/sdk/ packages/sdk/
COPY packages/appserver/ packages/appserver/

# Build the SDK (appserver depends on its dist output)
RUN pnpm --filter @roomy-space/sdk build

# ── Stage 2: Runtime ──────────────────────────────────────────────────────
# Bun version pinned to .bun-version (1.3.14).
FROM oven/bun:1.3.14 AS runtime

# Install Litestream for continuous SQLite WAL replication to S3-compatible
# storage (Railway S3 bucket). Mirrors the discord-bridge setup.
ARG LITESTREAM_VERSION=0.3.13
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates wget \
 && wget -q -O /tmp/litestream.tar.gz \
      "https://github.com/benbjohnson/litestream/releases/download/v${LITESTREAM_VERSION}/litestream-v${LITESTREAM_VERSION}-linux-amd64.tar.gz" \
 && tar -C /usr/local/bin -xzf /tmp/litestream.tar.gz \
 && rm /tmp/litestream.tar.gz \
 && apt-get purge -y wget \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy built workspace from build stage
COPY --from=build /project/packages/sdk packages/sdk
COPY --from=build /project/packages/tsconfig packages/tsconfig
COPY --from=build /project/packages/appserver packages/appserver
COPY --from=build /project/node_modules node_modules
COPY --from=build /project/package.json .

# Litestream config + restore/replicate entrypoint
COPY packages/appserver/litestream.yml /etc/litestream.yml
COPY packages/appserver/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Create data directory for SQLite databases. These live on the Railway
# persistent volume mounted at /data (the legacy APPSERVER_DB_PATH=
# /data/roomy.sqlite points at it too). Because the volume survives deploys,
# the per-space DBs (and their materialization_cursor / schema-version state)
# persist, so boot re-materialisation only replays the gap instead of
# rebuilding every space on each deploy.
RUN mkdir -p /data/spaces

# Static DBs (replicated by Litestream). The monolithic materialised DB was
# removed in the per-space split, so there is no APPSERVER_DB_PATH. Per-space
# DBs live under DATA_DIR/spaces and are derived/regenerable, so not listed
# here. DATA_DIR is the single knob for all DB paths + the signing key.
ENV DATA_DIR=/data

EXPOSE 8080

# The entrypoint restores the static DBs from S3 if absent (fail-closed: it
# refuses to start fresh when no backup is restorable, to avoid data loss),
# then runs the app under `litestream replicate` so WAL changes are
# continuously backed up. Per-space DBs (data/spaces/) are derived and
# regenerate via re-materialisation from the event log.
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
