// Grafana Alloy config — Roomy production telemetry collector (Grafana Cloud).
//
// Receives logs and traces from the Railway app services and forwards logs to
// Grafana Cloud Loki, traces to Grafana Cloud Tempo, and scrapes the
// appserver's Prometheus /metrics endpoint remote-written to Grafana Cloud
// Mimir. The apps POST to this collector (see deploy/alloy/README.md).
//
// Required env vars:
//   - GRAFANA_CLOUD_LOKI_URL    full push URL, e.g.
//                               https://logs-prod-<region>.grafana.net/loki/api/v1/push
//   - GRAFANA_CLOUD_LOKI_ID     Grafana Cloud Loki instance ID (basic auth user)
//   - GRAFANA_CLOUD_LOKI_TOKEN  Grafana Cloud access policy token (basic auth pass)
//   - GRAFANA_CLOUD_MIMIR_URL   Prometheus remote-write URL, e.g.
//                               https://prometheus-prod-<region>.grafana.net/api/prom/push
//   - GRAFANA_CLOUD_MIMIR_ID    Grafana Cloud Prometheus instance ID (basic auth user)
//   - GRAFANA_CLOUD_MIMIR_TOKEN Grafana Cloud access policy token (basic auth pass)
//
// Optional:
//   - APPSERVER_METRICS_URL     appserver scrape target as host:port (NO
//                               scheme or path), e.g. appserver:8080 or
//                               appserver.railway.internal:8080. Default
//                               appserver:8080 (set in the Dockerfile ENV;
//                               override on Railway). Scheme is http, path
//                               is /metrics.
//   - APPSERVER_STAGING_METRICS_URL
//                               the same shape, for the staging appserver.
//                               Unset (or empty) means the staging scrape
//                               component has no targets at all — see the
//                               `prometheus.scrape "appserver_staging"`
//                               block for why this is gated rather than
//                               given a coalesce placeholder.
//   - ALLOY_LOG_LEVEL           default `info`.
//
// Traces → Grafana Cloud Tempo (OTLP/HTTP):
//   - GRAFANA_CLOUD_TEMPO_URL   OTLP gateway base URL, e.g.
//                               https://otlp-gateway-prod-<region>.grafana.net/otlp
//                               (the exporter appends /v1/traces)
//   - GRAFANA_CLOUD_TEMPO_ID    Grafana Cloud instance ID (basic auth user)
//   - GRAFANA_CLOUD_TEMPO_TOKEN access policy token (basic auth pass)
//
//   These are deliberately NOT required: without them the exporter falls
//   back to a placeholder endpoint and the collector still loads, so a
//   deploy that forgets them cannot take logs/metrics down with it. Set
//   all three to actually ship spans to Tempo.

logging {
	level = "info" // override via ALLOY_LOG_LEVEL at runtime if desired
}

// ── Ship to Grafana Cloud Loki ────────────────────────────────────────
loki.write "cloud" {
	endpoint {
		url = sys.env("GRAFANA_CLOUD_LOKI_URL")

		basic_auth {
			username = sys.env("GRAFANA_CLOUD_LOKI_ID")
			password = sys.env("GRAFANA_CLOUD_LOKI_TOKEN")
		}
	}
}

// ── Ship metrics to Grafana Cloud Mimir ─────────────────────────────
prometheus.remote_write "mimir" {
	endpoint {
		url = sys.env("GRAFANA_CLOUD_MIMIR_URL")

		basic_auth {
			username = sys.env("GRAFANA_CLOUD_MIMIR_ID")
			password = sys.env("GRAFANA_CLOUD_MIMIR_TOKEN")
		}
	}
}

// ── Ship traces to Grafana Cloud Tempo ────────────────────────────────
// OTLP/HTTP exporter for spans received on 4317/4318 (and browser traces
// from the Faro receiver below). Grafana Cloud's OTLP gateway authenticates
// with the stack instance ID + access policy token over Basic auth.
//
// Gated with `coalesce`: sys.env() yields "" for an unset variable, and an
// empty endpoint or credential makes the component fail to build — which
// aborts the *entire* collector, not just this pipeline (see commit
// f9a66bcf). The placeholders keep the graph loadable when Tempo isn't
// configured; spans then retry against 127.0.0.1:1 (instant connection
// refused) for at most retry_on_failure.max_elapsed_time before being
// dropped, so they never block the shared batch processor.
otelcol.auth.basic "tempo" {
	username = coalesce(sys.env("GRAFANA_CLOUD_TEMPO_ID"), "tempo-not-configured")
	password = coalesce(sys.env("GRAFANA_CLOUD_TEMPO_TOKEN"), "tempo-not-configured")
}

otelcol.exporter.otlphttp "tempo" {
	client {
		endpoint = coalesce(sys.env("GRAFANA_CLOUD_TEMPO_URL"), "http://127.0.0.1:1")
		auth     = otelcol.auth.basic.tempo.handler
	}

	retry_on_failure {
		max_elapsed_time = "1m0s"
	}
}

// ── Receive logs from the Roomy app services ─────────────────────────
// Loki Push API receiver. Each app forwards its stdout here over the
// Railway private network. The forwarder POSTs Loki-compatible JSON to
//   http://<alloy>:3100/loki/api/v1/push
loki.source.api "apps" {
	http {
		listen_address = "0.0.0.0"
		listen_port    = 3100
	}
	forward_to = [loki.write.cloud.receiver]
}

// ── Scrape appserver Prometheus metrics ──────────────────────────────
// The appserver exposes /metrics (request latency, DB pool queue depth,
// cache hit rate, embed backlog, DB timeouts). Scrape it over the Railway
// private network and remote-write to Mimir.
//
// Two scrape components, one per environment, because a scrape target's
// labels are fixed for the life of the component: `env` is a target label
// here (it becomes a metric label on every series the target produces), so
// production and staging need a component each rather than one list of
// targets with a shared label.
//
// `build_id` is deliberately absent: one series set per deploy is never
// reclaimed, and the build identity stays in the log line and the trace
// resource where it costs no cardinality.
prometheus.scrape "appserver" {
	// __address__ must be host:port only (no scheme or path) — Prometheus
	// rejects a full URL here. The scheme defaults to http and the path is
	// set via metrics_path below.
	targets = [{
		__address__ = sys.env("APPSERVER_METRICS_URL"),
		env         = "production",
	}]
	metrics_path = "/metrics"
	forward_to   = [prometheus.remote_write.mimir.receiver]
}

// Staging is optional. The `coalesce` placeholder convention from the Tempo
// block applies, but the gating has to be a *drop* rather than an endpoint
// that merely fails: an unset variable left as a live scrape target would
// show up in Mimir as `up == 0` for a deployment that does not exist,
// erroring on every scrape interval. So the placeholder address is dropped
// by a relabel rule, leaving the scrape component with an empty target list
// — nothing scraped, nothing reported, and the collector still loads.
discovery.relabel "appserver_staging" {
	targets = [{
		__address__ = coalesce(sys.env("APPSERVER_STAGING_METRICS_URL"), "staging-not-configured"),
		env         = "staging",
	}]

	rule {
		source_labels = ["__address__"]
		regex         = "staging-not-configured"
		action        = "drop"
	}
}

prometheus.scrape "appserver_staging" {
	targets      = discovery.relabel.appserver_staging.output
	metrics_path = "/metrics"
	forward_to   = [prometheus.remote_write.mimir.receiver]
}

// ── OTLP receivers for the app services (4317 gRPC / 4318 HTTP) ──────
// Logs are converted to Loki below; traces are forwarded to Grafana Cloud
// Tempo. Both signals are batched by otelcol.processor.batch "default".
otelcol.receiver.otlp "apps" {
	grpc {
		endpoint = "0.0.0.0:4317"
	}

	http {
		endpoint = "0.0.0.0:4318"
	}

	output {
		logs   = [otelcol.processor.batch.default.input]
		traces = [otelcol.processor.batch.default.input]
	}
}

otelcol.processor.batch "default" {
	output {
		logs   = [otelcol.exporter.loki.apps.input]
		traces = [otelcol.exporter.otlphttp.tempo.input]
	}
}

otelcol.exporter.loki "apps" {
	forward_to = [loki.write.cloud.receiver]
}

// ── Faro browser telemetry receiver (app-lite) ───────────────────────
// The static SPA ships console logs + errors via the Grafana Faro browser
// agent. This mirrors the dev compose `faro.receiver "frontend"` block:
// logs pass through the same logfmt/label normalization so browser records
// land in Loki with the same labels as the app services. Browser traces are
// forwarded to Tempo alongside their logs (app-lite must enable Faro's
// TracingInstrumentation for any spans to exist — see packages/app-lite).
//
// Required env vars (set on Railway):
//   - FARO_CORS_ORIGINS   comma-separated allowed browser origins, default
//                         https://roomy.space (see Dockerfile ENV)
//   - FARO_API_KEY        Faro API key, default "" (unset)
loki.process "frontend" {
	forward_to = [loki.write.cloud.receiver]

	stage.logfmt {
		mapping = {"service_name" = "app_name", kind = ""}
	}

	stage.labels {
		values = {"kind" = "kind", "service_name" = "service_name", "app" = "service_name"}
	}

	// Make sure exceptions are logged at an error level instead of "unknown"
	stage.match {
		selector = "{kind=\"exception\"}"

		stage.template {
			source   = "const_error"
			template = "error"
		}

		stage.structured_metadata {
			values = {
				"level" = "const_error",
			}
		}
	}
}

faro.receiver "frontend" {
	server {
		listen_address           = "0.0.0.0"
		listen_port              = 12345
		cors_allowed_origins     = string.split(sys.env("FARO_CORS_ORIGINS"), ",")
		api_key                  = sys.env("FARO_API_KEY")
		max_allowed_payload_size = "10MiB"

		rate_limiting {
			rate = 100
		}
	}

	output {
		logs   = [loki.process.frontend.receiver]
		traces = [otelcol.processor.batch.default.input]
	}
}
